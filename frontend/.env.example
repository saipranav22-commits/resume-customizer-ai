# Resume Customizer AI — Frontend Environment Variables
# In production on Vercel, set this to your deployed Render backend URL (e.g., https://resume-customizer-ai.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Authentication & PostgreSQL Configuration (Phase 5A)
# Retrieve your Project URL and Publishable Key from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Modern Supabase Publishable Key format (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy fallback (optional):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
