# LLM API Configuration
# Get your free Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model (e.g., gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.0-flash)
LLM_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini

# Application Settings
MAX_FILE_SIZE_MB=5
MIN_JD_LENGTH=50
PORT=8000
ENVIRONMENT=development

# Supabase Authentication & PostgreSQL Configuration (Phase 5A)
# Retrieve keys from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Modern Supabase JWKS endpoint for asymmetric JWT public key retrieval
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Modern Supabase Publishable Key (sb_publishable_...) - used for PostgREST user-scoped queries
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Standard API key fallback (defaults to SUPABASE_PUBLISHABLE_KEY)
SUPABASE_KEY=your-supabase-publishable-key
# Server-side Secret Key (sb_secret_...) - ONLY for explicit privileged background operations
# SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy JWT secret (only required if using legacy symmetric HS256)
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings
SUPABASE_JWT_AUDIENCE=authenticated

# Optional direct PostgreSQL connection string (Transaction Pooler or Direct)
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Local SQLite fallback path (used in offline testing and local development)
LOCAL_DB_PATH=E:\ResumeCustomizerAI\.tmp\history.db
